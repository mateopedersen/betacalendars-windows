<Window x:Class="BetaCalendars.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Beta Calendars Studio" Height="780" Width="1220" MinHeight="620" MinWidth="920" Background="#F4F6F8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#172A38"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top" Margin="18,24,18,16"><TextBlock Text="BETA CALENDARS" Foreground="#9FC4CF" FontSize="11" FontWeight="Bold"/><TextBlock Text="Studio" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="#E9F0F3" SelectionChanged="Navigation_SelectionChanged" FontSize="14" Padding="8"><ListBoxItem Content="Month" IsSelected="True"/><ListBoxItem Content="Year"/><ListBoxItem Content="Blank Designer"/><ListBoxItem Content="Date Inspector"/><ListBoxItem Content="ISO Week Lab"/><ListBoxItem Content="Print Studio"/><ListBoxItem Content="Calendar Lab"/><ListBoxItem Content="Resources"/><ListBoxItem Content="Settings"/><ListBoxItem Content="About"/></ListBox><TextBlock DockPanel.Dock="Bottom" Text="Offline calendar tools · 1.0.0" Foreground="#9FC4CF" Margin="20" FontSize="11"/></DockPanel></Border>
    <Grid Grid.Column="1" Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,20"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="PageTitle" Text="Month" FontSize="28" FontWeight="SemiBold" Foreground="#182B38"/><TextBlock x:Name="Subtitle" Text="Explore Gregorian month geometry." Foreground="#657784" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="SVG" Click="ExportSvg_Click"/><Button Content="HTML" Click="ExportHtml_Click"/><Button Content="JSON" Click="ExportJson_Click"/><Button Content="CSV" Click="ExportCsv_Click"/><Button Content="Print" Click="Print_Click"/></StackPanel></DockPanel><Border Grid.Row="1" Background="White" CornerRadius="10" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button Content="‹ Previous" Click="Previous_Click"/><Button Content="Today" Click="Today_Click"/><Button Content="Next ›" Click="Next_Click"/><TextBlock Text="Month" VerticalAlignment="Center" Margin="18,0,5,0"/><ComboBox x:Name="MonthPicker" Width="132" SelectionChanged="SelectionChanged"/><TextBlock Text="Year" VerticalAlignment="Center" Margin="12,0,5,0"/><TextBox x:Name="YearPicker" Width="80" Text="2027" VerticalContentAlignment="Center" TextChanged="SelectionChanged"/><TextBlock Text="Week starts" VerticalAlignment="Center" Margin="12,0,5,0"/><ComboBox x:Name="WeekStartPicker" Width="105" SelectionChanged="SelectionChanged"><ComboBoxItem Content="Monday" IsSelected="True"/><ComboBoxItem Content="Sunday"/></ComboBox></StackPanel><TextBlock x:Name="Summary" FontSize="19" FontWeight="SemiBold" Foreground="#285C72" Margin="0,0,0,14"/><UniformGrid x:Name="CalendarGrid" Columns="7"/><TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#526571" Margin="0,20,0,0"/><StackPanel x:Name="DynamicPanel" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border></Grid>
  </Grid>
</Window>
